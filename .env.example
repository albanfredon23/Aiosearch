# Copier en .env puis adapter. Aucune variable n'est obligatoire : sans clé LLM, AIOTECH répond
# hors ligne (règles, réponses gabarit vérifiées) et le benchmark tourne sur CPU.

# Port publié par nginx (seul service exposé)
AIOTECH_HTTP_PORT=8080

# LLM : anthropic (défaut, Claude) | litellm (tout autre fournisseur) | none
AIOTECH_LLM_PROVIDER=anthropic
AIOTECH_LLM_MODEL=claude-opus-5-5
# Modèle rapide pour l'extraction (facultatif), modèles de repli LiteLLM séparés par des virgules
AIOTECH_LLM_FAST_MODEL=claude-haiku-4-5-20251001
AIOTECH_LLM_FALLBACK_MODELS=
ANTHROPIC_API_KEY=
# Pour LiteLLM : clé du fournisseur choisi (OPENAI_API_KEY, MISTRAL_API_KEY, ...) et URL éventuelle
AIOTECH_LLM_API_BASE=

# Clés de l'API publique (/v1, /mcp) : "nom:clé" séparées par des virgules, 16 caractères minimum.
# La clé de l'interface web est générée automatiquement au premier démarrage.
AIOTECH_API_KEYS=
# Jeton exigé en plus d'une clé sur /admin (accessible depuis le réseau local seulement)
AIOTECH_ADMIN_TOKEN=
AIOTECH_QUOTA_PER_MINUTE=30
AIOTECH_QUOTA_PER_DAY=2000

# Corpus de démonstration (produits fictifs, textes juridiques) chargé au démarrage
AIOTECH_LOAD_DEMO=true

# Neo4j (profil "graph") : décommenter pour enregistrer chaque graphe de recherche
# AIOTECH_NEO4J_URL=bolt://neo4j:7687
# AIOTECH_NEO4J_PASSWORD=choisir-un-mot-de-passe-long
